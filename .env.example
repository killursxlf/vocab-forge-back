NODE_ENV=development
PORT=3000
# Use pooled TCP and direct TCP URLs for the same Prisma Postgres database.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Optional: leave both empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Set only the actual reverse proxy IPs/CIDRs. Never use true or 0.0.0.0/0.
TRUST_PROXY=
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
LEARN_STREAK_THRESHOLD=3
DOWNGRADE_ON_MISS=true
DOWNGRADE_MISS_THRESHOLD=3
